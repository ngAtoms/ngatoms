{
  "name": "ngatoms-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint packages/primitives/src packages/utils/src packages/ngatoms/src packages/ngatoms/bin apps/docs/src",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "publish:changesets": "changeset publish",
    "pre:enter:lts": "changeset pre enter lts",
    "pre:enter:rc": "changeset pre enter rc",
    "pre:exit": "changeset pre exit",
    "status:changesets": "changeset status --verbose",
    "publish:latest": "node tools/scripts/publish.mjs --channel latest",
    "publish:latest:dry": "node tools/scripts/publish.mjs --channel latest --dry-run",
    "publish:lts": "node tools/scripts/publish.mjs --channel lts",
    "publish:lts:dry": "node tools/scripts/publish.mjs --channel lts --dry-run",
    "publish:rc": "node tools/scripts/publish.mjs --channel rc",
    "publish:rc:dry": "node tools/scripts/publish.mjs --channel rc --dry-run"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/cli": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/compiler-cli": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/web": "^2.1.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "rxjs": "^7.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
